{
    "tblname": "downapp",
    "title":"下位系统",
    "params": {
        "sortby":"id",
        "confidential_fields":["secretkey"],
		"logined_userorgid": "orgid",
        "browserfields": {
            "exclouded": ["secretkey", "orgid" ],
            "alters": {}
        },
        "editexclouded": [
            "secretkey", "orgid"
        ],
		"toolbar":{
			"tools":[
				{
					"name":"create_apikey",
					"label":"创建apikey",
					"icon":"{{entire_url('/imgs/newkey.svg')}}"
				},
				{
					"name":"copy_apikey",
					"label":"复制apikey",
					"selected_row":true,
					"icon":"{{entire_url('/imgs/copy.svg')}}"
				}
			]
		},
		"binds":[
			{
				"wid":"self",
				"event":"create_apikey",
				"actiontype":"urlwidget",
				"target":"PopupWindow",
				"popup_options":{
					"width":"50%",
					"height":"50%",
					"archor":"cr"
				},
				"options":{
					"url":"{{entire_url('/dapi/create_apikey.ui')}}"
				}
			},
			{
				"wid":"self",
				"event":"copy_apikey",
				"actiontype":"urlwidget",
				"target":"PopupWindow",
				"popup_options":{
					"width":"50%",
					"height":"50%",
					"archor":"cr"
				},
				"options":{
					"url":"{{entire_url('/dapi/copy_apikey.dspy')}}"
				}
			}
		]
    }
}

